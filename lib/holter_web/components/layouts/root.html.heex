<!DOCTYPE html>
<html lang={assigns[:current_locale] || "pt_BR"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="request-id" content={assigns[:request_id]} />
    <.live_title default="Holter" prefix="Holter - ">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
    <meta id="app-config" data-config={app_config_json()} />
  </head>
  <body>
    <%= if assigns[:impersonator_email] do %>
      <div class="h-impersonation-pill" role="status">
        <span class="h-impersonation-pill-label">{gettext("Impersonating")}</span>
        <span class="h-impersonation-pill-actor" title={@impersonator_email}>
          {@impersonator_email}
        </span>
        <.link
          href={~p"/admin/impersonation"}
          method="delete"
          class="h-impersonation-pill-exit"
        >
          {gettext("Exit")}
        </.link>
      </div>
    <% end %>
    {@inner_content}
  </body>
</html>
