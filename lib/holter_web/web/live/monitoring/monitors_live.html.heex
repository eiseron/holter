<div class="h-workspace-content">
  <.dashboard_header title={gettext("Monitors")} subtitle={gettext("Real-time Overview")}>
    <:actions>
      <%= if @at_quota do %>
        <span
          class="h-btn h-btn-primary h-btn-disabled"
          title={gettext("Monitor limit reached (%{max}/%{max})", max: @workspace.max_monitors)}
        >
          <.icon name="plus" />
          {gettext("New Monitor")}
        </span>
      <% else %>
        <.link
          navigate={~p"/monitoring/workspaces/#{@workspace.slug}/monitor/new"}
          class="h-btn h-btn-primary"
        >
          <.icon name="plus" />
          {gettext("New Monitor")}
        </.link>
      <% end %>
    </:actions>
  </.dashboard_header>

  <%= if Enum.empty?(@monitors) do %>
    <.empty_state
      variant="boxed"
      title={gettext("No monitors yet")}
      description={gettext("Create your first monitor to start tracking uptime and latency.")}
    >
      <:icon>
        <.icon name="monitor" class="h-icon-size-8" />
      </:icon>
      <:actions :if={not @at_quota}>
        <.link
          navigate={~p"/monitoring/workspaces/#{@workspace.slug}/monitor/new"}
          class="h-btn h-btn-primary"
        >
          <.icon name="plus" />
          {gettext("New Monitor")}
        </.link>
      </:actions>
    </.empty_state>
  <% else %>
    <div class="pulse-grid">
      <%= for monitor <- @monitors do %>
        <.monitor_card
          monitor={monitor}
          detail_url={~p"/monitoring/monitor/#{monitor.id}"}
        />
      <% end %>
    </div>
  <% end %>
</div>
