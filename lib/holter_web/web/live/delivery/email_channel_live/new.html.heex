<.page_container>
  <:title>
    <.back_link navigate={~p"/delivery/workspaces/#{@workspace.slug}/channels"} />
    {gettext("New Email Channel")}
  </:title>
  <:actions>
    <p class="h-text-muted">
      {gettext("Configure the email destination for monitoring alerts.")}
    </p>
  </:actions>

  <.form
    for={@form}
    id="email-channel-form"
    phx-change="validate"
    phx-submit="save"
    class="h-form-sections"
  >
    <.email_channel_form_fields form={@form} />

    <.monitor_channel_select monitors={@available_monitors} selected_ids={[]} />
  </.form>

  <section class="h-fieldset-card h-mt-8">
    <h3 class="h-fieldset-legend">{gettext("Recipients")}</h3>
    <p class="h-help-text h-mb-4">
      {gettext(
        "Addresses that receive each alert. Each address must be verified after the channel is created."
      )}
    </p>

    <.form
      id="add-recipient-form"
      for={%{}}
      as={:recipient}
      phx-submit="add_pending_recipient"
      class="h-recipient-add-form"
    >
      <input
        type="email"
        name="recipient[email]"
        value=""
        placeholder={gettext("recipient@example.com")}
        required
        class="h-input h-recipient-email-input"
      />
      <.button type="submit">{gettext("Add Recipient")}</.button>
    </.form>

    <%= if @pending_recipients == [] do %>
      <p class="h-recipient-empty">{gettext("No recipients added yet.")}</p>
    <% else %>
      <ul class="h-recipients-list h-mt-4" role="list">
        <%= for email <- @pending_recipients do %>
          <li class="h-recipient-item">
            <span class="h-recipient-email">{email}</span>
            <span class="h-recipient-badge h-recipient-badge--draft">
              {gettext("Draft")}
            </span>
            <button
              type="button"
              phx-click="remove_pending_recipient"
              phx-value-email={email}
              class="h-recipient-remove"
              aria-label={gettext("Remove %{email}", email: email)}
            >
              &times;
            </button>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <div class="h-actions-row h-justify-end h-mt-8">
    <.button
      type="submit"
      form="email-channel-form"
      phx-disable-with={gettext("Saving...")}
      variant="primary"
    >
      {gettext("Create Email Channel")}
    </.button>
  </div>
</.page_container>
