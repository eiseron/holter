<.channel_form
  channel={@channel}
  workspace={@workspace}
  form={@form}
  form_id="email-channel-form"
  subtype_label={gettext("Email channel")}
  logs_path={~p"/delivery/email-channels/#{@channel.id}/logs"}
  workspace_channels_path={~p"/delivery/workspaces/#{@workspace.slug}/channels"}
  available_monitors={@available_monitors}
  linked_monitor_ids={@linked_monitor_ids}
  cooldown_remaining={@cooldown_remaining}
>
  <:type_fields>
    <.email_channel_form_fields form={@form} />
  </:type_fields>

  <:secret_card>
    <.secret_card
      id="phishing"
      title={gettext("Anti-phishing code")}
      help={
        gettext(
          "This code appears at the bottom of every email Holter sends through this channel. Save it. If a future email claims to be from Holter and the code is missing or different, it's a phishing attempt."
        ) <>
          " " <>
          gettext("Regenerate if leaked.")
      }
      reveal_label={gettext("Show anti-phishing code")}
      value={@channel.anti_phishing_code}
    />
  </:secret_card>

  <:siblings>
    <section class="h-fieldset-card h-mt-8">
      <h3 class="h-fieldset-legend">{gettext("Recipients")}</h3>
      <p class="h-help-text h-mb-4">
        {gettext(
          "Addresses that receive each alert. Each address must be verified before receiving notifications. Additions and removals only apply when you save."
        )}
      </p>

      <.form
        id="add-recipient-form"
        for={%{}}
        as={:recipient}
        phx-submit="add_pending_recipient"
        class="h-recipient-add-form"
      >
        <input
          type="email"
          name="recipient[email]"
          value=""
          placeholder={gettext("recipient@example.com")}
          required
          class="h-input h-recipient-email-input"
        />
        <.button type="submit">{gettext("Add Recipient")}</.button>
      </.form>

      <%= if @saved_recipients == [] and @pending_additions == [] do %>
        <p class="h-recipient-empty">{gettext("No recipients yet.")}</p>
      <% else %>
        <ul class="h-recipients-list h-mt-4" role="list">
          <%= for recipient <- @saved_recipients do %>
            <% pending_removal? = MapSet.member?(@pending_removed_ids, recipient.id) %>
            <li class={["h-recipient-item", pending_removal? && "h-recipient-item--removed"]}>
              <span class="h-recipient-email">{recipient.email}</span>
              <%= cond do %>
                <% pending_removal? -> %>
                  <span class="h-recipient-badge h-recipient-badge--remove">
                    {gettext("Will be removed")}
                  </span>
                  <button
                    type="button"
                    phx-click="restore_recipient"
                    phx-value-id={recipient.id}
                    class="h-recipient-resend"
                    aria-label={gettext("Restore %{email}", email: recipient.email)}
                  >
                    {gettext("Restore")}
                  </button>
                <% recipient.verified_at -> %>
                  <span class="h-recipient-badge h-recipient-badge--verified">
                    {gettext("Verified")}
                  </span>
                <% true -> %>
                  <span class="h-recipient-badge h-recipient-badge--pending">
                    {gettext("Pending verification")}
                  </span>
                  <button
                    type="button"
                    phx-click="resend_recipient_verification"
                    phx-value-id={recipient.id}
                    phx-disable-with={gettext("Sending...")}
                    class="h-recipient-resend"
                    aria-label={
                      gettext("Resend verification email to %{email}", email: recipient.email)
                    }
                  >
                    {gettext("Resend")}
                  </button>
              <% end %>
              <%= unless pending_removal? do %>
                <button
                  type="button"
                  phx-click="mark_recipient_for_removal"
                  phx-value-id={recipient.id}
                  class="h-recipient-remove"
                  aria-label={gettext("Remove %{email}", email: recipient.email)}
                >
                  &times;
                </button>
              <% end %>
            </li>
          <% end %>
          <%= for email <- @pending_additions do %>
            <li class="h-recipient-item h-recipient-item--pending">
              <span class="h-recipient-email">{email}</span>
              <span class="h-recipient-badge h-recipient-badge--draft">
                {gettext("Draft")}
              </span>
              <button
                type="button"
                phx-click="cancel_pending_recipient"
                phx-value-email={email}
                class="h-recipient-remove"
                aria-label={gettext("Cancel %{email}", email: email)}
              >
                &times;
              </button>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </:siblings>

  <:regenerate_modal>
    <.modal id="regenerate-secret-modal" title={gettext("Regenerate anti-phishing code")}>
      <p>
        {gettext(
          "Regenerating replaces the code shown in future emails. Recipients trained on the old code will see the new one in the next email."
        )}
      </p>
      <:footer>
        <button
          type="button"
          class="h-btn h-btn-soft"
          phx-click={JS.set_attribute({"hidden", ""}, to: "#regenerate-secret-modal")}
        >
          {gettext("Cancel")}
        </button>
        <button
          type="button"
          class="h-btn h-btn-danger"
          phx-click={
            JS.push("regenerate_secret")
            |> JS.set_attribute({"hidden", ""}, to: "#regenerate-secret-modal")
          }
          phx-disable-with={gettext("Regenerating...")}
        >
          {gettext("Yes, Regenerate")}
        </button>
      </:footer>
    </.modal>
  </:regenerate_modal>
</.channel_form>
