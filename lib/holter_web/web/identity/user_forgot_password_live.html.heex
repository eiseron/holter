<.auth_screen title={gettext("Forgot your password?")}>
  <p>
    {gettext("Enter your account email. If it exists, we will send you reset instructions.")}
  </p>

  <.form
    for={@form}
    id="forgot-password-form"
    phx-submit="save"
    class="h-auth-screen-form"
    data-no-warn
  >
    <.input
      field={@form[:email]}
      type="email"
      label={gettext("Email")}
      autocomplete="email"
      required
      phx-debounce="500"
    />

    <.button type="submit" variant="primary">{gettext("Send instructions")}</.button>
  </.form>

  <:footer>
    <.link navigate={~p"/identity/login"}>{gettext("Back to sign in")}</.link>
  </:footer>
</.auth_screen>
