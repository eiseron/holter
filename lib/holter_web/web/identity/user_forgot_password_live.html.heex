<section class="h-auth-screen">
  <h1>{gettext("Forgot your password?")}</h1>

  <p>
    {gettext("Enter your account email. If it exists, we will send you reset instructions.")}
  </p>

  <.form for={@form} id="forgot-password-form" phx-submit="save" class="h-form-sections">
    <label>
      <span>{gettext("Email")}</span>
      <input
        type="email"
        name="user[email]"
        value={Phoenix.HTML.Form.input_value(@form, :email)}
        autocomplete="email"
        required
        phx-debounce="500"
      />
      <%= for msg <- translate_errors(@form.errors, :email) do %>
        <span class="h-input-error">{msg}</span>
      <% end %>
    </label>

    <button type="submit">{gettext("Send instructions")}</button>
  </.form>

  <p>
    <.link navigate={~p"/identity/login"}>{gettext("Back to sign in")}</.link>
  </p>
</section>
