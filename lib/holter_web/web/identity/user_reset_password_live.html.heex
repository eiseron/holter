<section class="h-auth-screen">
  <h1>{gettext("Set a new password")}</h1>

  <.form for={@form} id="reset-password-form" phx-submit="save" class="h-form-sections">
    <label>
      <span>{gettext("New password")}</span>
      <input
        type="password"
        name="user[password]"
        autocomplete="new-password"
        minlength="12"
        required
        phx-debounce="500"
      />
      <%= for msg <- translate_errors(@form.errors, :password) do %>
        <span class="h-input-error">{msg}</span>
      <% end %>
      <span class="h-help-text">
        {gettext("At least 12 characters with uppercase, lowercase, and a digit.")}
      </span>
    </label>

    <label>
      <span>{gettext("Confirm new password")}</span>
      <input
        type="password"
        name="user[password_confirmation]"
        autocomplete="new-password"
        minlength="12"
        required
        phx-debounce="500"
      />
      <%= for msg <- translate_errors(@form.errors, :password_confirmation) do %>
        <span class="h-input-error">{msg}</span>
      <% end %>
    </label>

    <button type="submit">{gettext("Update password")}</button>
  </.form>

  <p>
    <.link navigate={~p"/identity/login"}>{gettext("Back to sign in")}</.link>
  </p>
</section>
